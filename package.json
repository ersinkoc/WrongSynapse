{
  "name": "wrongsynapse",
  "version": "0.1.4",
  "description": "Local-first Cognitive Memory Operating System and MCP server for autonomous AI coding agents. Tri-hybrid retrieval: ONNX semantic embeddings + SQLite FTS5/BM25 + hierarchical knowledge graph, fused with Reciprocal Rank Fusion. Zero cloud.",
  "type": "module",
  "license": "MIT",
  "author": "Ersin KOÇ",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ersinkoc/WrongSynapse.git"
  },
  "bugs": {
    "url": "https://github.com/ersinkoc/WrongSynapse/issues"
  },
  "homepage": "https://github.com/ersinkoc/WrongSynapse#readme",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "wrongsynapse": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "CHANGELOG.md",
    "web/dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run typecheck && npm test && npm run web:build && npm run build",
    "release": "node scripts/release.mjs",
    "release:check": "node scripts/release.mjs --check",
    "demo": "node dist/index.js --demo",
    "web:install": "npm --prefix web install",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web install --no-audit --no-fund && npm --prefix web run build",
    "web:typecheck": "npm --prefix web run typecheck"
  },
  "keywords": [
    "mcp",
    "memory",
    "cognitive-memory",
    "rag",
    "vector-search",
    "fts5",
    "bm25",
    "knowledge-graph",
    "sqlite",
    "embeddings",
    "tree-sitter",
    "local-first"
  ],
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "ignore": "^7.0.6",
    "simple-git": "^3.36.0",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.26.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "protobufjs": "^7.6.5",
    "sharp": "^0.35.3",
    "adm-zip": "^0.6.0"
  }
}
